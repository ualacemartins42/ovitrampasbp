# Desenvolvimento: copie para .env
# Produção (Vercel): Settings → Environment Variables (Production)
# Prefixo VITE_ é embutido no build — defina as variáveis antes de publicar.

VITE_APP_URL=https://ovitrampasbp.vercel.app
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publicavel

# ContaOvos — mapa de calor (chave opcional; sem chave usa API pública municipal)
# Docs: https://contaovos.com/pt-br/api/
VITE_CONTAOVOS_BASE_URL=https://contaovos.com/pt-br/api
VITE_CONTAOVOS_API_KEY=
